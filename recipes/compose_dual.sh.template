#!/usr/bin/env bash
# compose_dual.sh.template — Dual-output compose recipe.
# COPY this template, fill in INPUTS + FILTER_CHAIN + DURATION, run.
#
# Produces:
#   <out>/整片.mp4    (H.264 + AAC, speech audio + all overlays)
#   <out>/broll层.mov (ProRes 4444 alpha, transparent gaps + cues, no audio)

set -e

# ───────────────────────────────────────────────────────────────────
# CONFIG — edit per project
# ───────────────────────────────────────────────────────────────────
SPEECH=/path/to/speech.mov          # talking-head source
DURATION=122.93                     # output duration (seconds)
OUT_DIR=/path/to/output_dir
ALPHA_COMPOSE_MODE=concat_nonoverlap # concat_nonoverlap is safest for B-Roll only
mkdir -p "$OUT_DIR"

# Each overlay: (file, time_offset_s, enable_start_s, enable_end_s)
# Order: chronological. Cream-bg cutaways and alpha chyrons mix freely.
OVERLAYS=(
  # file                    offset   enable_start enable_end
  "title.mov                0        0            4.5"
  "scene1.mp4               6        6            8"
  "chyron_humble.mov        8        8            9.6"
  "chyron_curious.mov       9.6      9.6          11.1"
  "chyron_bold.mov          11.1     11.1         13"
  "scene_data_bars.mp4      65       65           68"
  # …add more cues…
)

# ───────────────────────────────────────────────────────────────────
# Build ffmpeg input args + filter chain (auto)
# ───────────────────────────────────────────────────────────────────
INPUT_ARGS=""
FILTER=""
PREV="[0:v]"
i=1
for line in "${OVERLAYS[@]}"; do
  read -r file offset estart eend <<< "$line"
  INPUT_ARGS+=" -itsoffset $offset -i $file"
  CUR="[$i:v]"
  NEXT="[v$i]"
  # format=auto preserves alpha for transparent overlays;
  # opaque mp4 cutaways ignore it harmlessly
  FILTER+="${PREV}${CUR}overlay=enable='between(t,$estart,$eend)':format=auto${NEXT};"
  PREV="$NEXT"
  i=$((i+1))
done
# Strip trailing semicolon, replace last [vN] with [vout].
# ⚠ Use bash literal suffix-strip, NOT sed — sed/glob treat "[v7]" as a
#   bracket expression (matches 'v' or '7'), so the label never substitutes
#   and ffmpeg errors "Output label 'vout' does not exist". Quoting the
#   pattern in ${var%"..."} forces a literal match.
FILTER="${FILTER%;}"
LAST_TAG="[v$((i-1))]"
FILTER="${FILTER%"$LAST_TAG"}[vout]"

# ───────────────────────────────────────────────────────────────────
# Output 1: integrated mp4 (speech base + all overlays + audio)
# ───────────────────────────────────────────────────────────────────
echo "▶ Composing integrated mp4…"
ffmpeg -nostdin -y \
  -i "$SPEECH" \
  $INPUT_ARGS \
  -filter_complex "$FILTER" \
  -map "[vout]" -map 0:a \
  -c:v libx264 -pix_fmt yuv420p -crf 20 -preset fast \
  -c:a aac -b:a 192k -shortest \
  "$OUT_DIR/整片.mp4"

# ───────────────────────────────────────────────────────────────────
# Output 2: alpha-only broll layer
#
# Default: concat transparent gaps + cue files. This avoids the common
# premultiplied-looking RGB bug where cream cards become gray after a
# ProRes alpha layer is composited over the speech video.
#
# If two cues truly overlap, render those simultaneous elements into one
# cue first. Only set ALPHA_COMPOSE_MODE=overlay_chain as a deliberate
# fallback, then do a real speech-background contact sheet before delivery.
# ───────────────────────────────────────────────────────────────────
echo "▶ Composing alpha broll layer…"
if [[ "$ALPHA_COMPOSE_MODE" == "overlay_chain" ]]; then
  echo "⚠ Using overlay_chain for alpha output. QA over the real speech video is mandatory."
  ffmpeg -nostdin -y \
    -f lavfi -i "color=color=black@0.0:size=1080x1920:duration=$DURATION:rate=30,format=yuva420p" \
    $INPUT_ARGS \
    -filter_complex "$FILTER" \
    -map "[vout]" \
    -c:v prores_ks -profile:v 4 -pix_fmt yuva444p10le \
    "$OUT_DIR/broll层.mov"
else
  alpha_inputs=()
  alpha_filter=""
  concat_labels=""
  input_idx=0
  seg_idx=0
  cursor=0

  add_gap() {
    local gap="$1"
    if awk -v g="$gap" 'BEGIN { exit !(g > 0.0005) }'; then
      alpha_inputs+=(
        -f lavfi -t "$gap" -i "color=color=black@0.0:size=1080x1920:rate=30,format=yuva444p10le"
      )
      alpha_filter+="[$input_idx:v]format=yuva444p10le,setpts=PTS-STARTPTS[s$seg_idx];"
      concat_labels+="[s$seg_idx]"
      input_idx=$((input_idx + 1))
      seg_idx=$((seg_idx + 1))
    fi
  }

  for line in "${OVERLAYS[@]}"; do
    read -r file offset estart eend <<< "$line"
    if awk -v s="$estart" -v c="$cursor" 'BEGIN { exit !(s < c - 0.0005) }'; then
      echo "ERROR: alpha concat needs non-overlapping cues. '$file' starts at $estart before previous cue ends at $cursor." >&2
      echo "Render overlapping elements into one cue, or set ALPHA_COMPOSE_MODE=overlay_chain and QA carefully." >&2
      exit 1
    fi

    gap=$(awk -v s="$estart" -v c="$cursor" 'BEGIN { printf "%.6f", s - c }')
    add_gap "$gap"

    planned_dur=$(awk -v e="$eend" -v s="$estart" 'BEGIN { printf "%.6f", e - s }')
    actual_dur=$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$file" | tr -d '[:space:]')
    cue_dur=$(awk -v p="$planned_dur" -v a="$actual_dur" 'BEGIN {
      d = (a > 0 && a < p) ? a : p;
      printf "%.6f", d;
    }')
    if awk -v d="$cue_dur" 'BEGIN { exit !(d <= 0) }'; then
      echo "ERROR: cue '$file' has non-positive duration ($cue_dur)." >&2
      exit 1
    fi

    alpha_inputs+=(-t "$cue_dur" -i "$file")
    alpha_filter+="[$input_idx:v]fps=30,scale=1080:1920,format=yuva444p10le,setpts=PTS-STARTPTS[s$seg_idx];"
    concat_labels+="[s$seg_idx]"
    input_idx=$((input_idx + 1))
    seg_idx=$((seg_idx + 1))
    cursor=$(awk -v s="$estart" -v d="$cue_dur" 'BEGIN { printf "%.6f", s + d }')
  done

  tail_gap=$(awk -v d="$DURATION" -v c="$cursor" 'BEGIN { printf "%.6f", d - c }')
  add_gap "$tail_gap"

  alpha_filter+="${concat_labels}concat=n=$seg_idx:v=1:a=0,format=yuva444p10le[vout]"

  ffmpeg -nostdin -y \
    "${alpha_inputs[@]}" \
    -filter_complex "$alpha_filter" \
    -map "[vout]" \
    -t "$DURATION" \
    -c:v prores_ks -profile:v 4 -pix_fmt yuva444p10le \
    "$OUT_DIR/broll层.mov"
fi

echo ""
echo "✓ Done. Outputs:"
ls -lh "$OUT_DIR"/{整片.mp4,broll层.mov}
